# ==============================================================================
# Cấu hình Branding tập trung (thay thế hocdev.com tại đây rồi chạy build.sh)
# ==============================================================================

# 1. Maintainer cho DEBIAN/control của gói found-desktop
MAINTAINER_NAME="OS Support Team"
MAINTAINER_EMAIL="support@hocdev.com"

# 2. Control Center About/Info (/usr/bin/found-control-center)
CONTROL_CENTER_EMAIL="linux@hocdev.com"

# 3. Desktop Version (/etc/desktop/version)
DESKTOP_NAME="FoundUI"
DESKTOP_VERSION="5.0"
DESKTOP_RELEASE="202503"

# 4. Polkit Policy (/usr/share/polkit-1/actions/org.found.locale.policy)
POLKIT_VENDOR="OS Support Team"
POLKIT_VENDOR_URL="http://www.hocdev.com"
