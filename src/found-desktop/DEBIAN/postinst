#!/bin/sh
dire="/usr/share"
chmod -R 666 $dire/found-desktop/data/newly-install.xml
mkdir -p $dire/backgrounds
#cp watermark files
watermark1=$dire/backgrounds/bg-watermark-unregistered.png
watermark2=$dire/backgrounds/bg-watermark.png
watermark3=$dire/backgrounds/bg-watermark-unregistered-en.png
unregistered1=$dire/backgrounds/bg-unregistered.png
unregistered2=$dire/backgrounds/bg-unregistered-en.png

if [ ! -L $watermark1 ];then
    ln -sf $dire/found-desktop/data/bg-watermark-unregistered.png $watermark1
fi
if [ ! -L $watermark2 ];then
    ln -sf $dire/found-desktop/data/bg-watermark.png $watermark2
fi
if [ ! -L $watermark3 ];then
    ln -sf $dire/found-desktop/data/bg-watermark-unregistered-en.png $watermark3
fi
if [ ! -L $unregistered1 ];then
    ln -sf $dire/found-desktop/data/bg-unregistered.png $unregistered1
fi
if [ ! -L $unregistered2 ];then
    ln -sf $dire/found-desktop/data/bg-unregistered-en.png $unregistered2
fi

#BUG-11600:锁屏认证过程中审计日志无法写入,增加写入权限。
if [ -L "/usr/sbin/setcap" ] || [ -e "/sbin/setcap" ];then
    setcap CAP_AUDIT_WRITE+ep /usr/libexec/cdos-user-verify || true
fi

# clean startup background file in old version.
startup_background_file=/etc/X11/Xsession.d/10desktop-startup-background
if [ -f $startup_background_file ];then
    rm $startup_background_file
fi
