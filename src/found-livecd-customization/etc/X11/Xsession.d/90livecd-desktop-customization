# livecd desktop customization
gsettings set org.cdos.settings-daemon.plugins.power sleep-display-ac 0
gsettings set org.cdos.settings-daemon.plugins.power sleep-display-battery 0
gsettings set org.cdos.settings-daemon.plugins.power sleep-inactive-ac-timeout 0
gsettings set org.cdos.settings-daemon.plugins.power sleep-inactive-battery-timeout 0

gsettings set org.cdos.settings-daemon.plugins.power idle-screensaver-timeout 0
gsettings set org.cdos.settings-daemon.plugins.power lock-on-screensaver true
gsettings set org.cdos.desktop.session idle-delay 0
xset -dpms s off

if [ -f "$HOME/Desktop/nfs-install.desktop" ]; then
    chmod +x "$HOME/Desktop/nfs-install.desktop" 2>/dev/null || true
    gio set "$HOME/Desktop/nfs-install.desktop" metadata::trusted true 2>/dev/null || true
fi
