#!/bin/sh

vos_restore_background() (
    schema=$1
    selected=$(gsettings get "$schema" picture-uri 2>/dev/null) || exit 0
    uri=${selected#\'}
    uri=${uri%\'}
    path=${uri#file://}

    case "$path" in
        /usr/share/backgrounds/found/*) ;;
        *) exit 0 ;;
    esac
    [ -f "$path" ] && exit 0

    if [ "$path" = /usr/share/backgrounds/found/default.jpg ] ||
       [ "$path" = /usr/share/backgrounds/found/default.png ]; then
        gsettings set "$schema" picture-uri "${uri%.*}.svg"
    else
        gsettings reset "$schema" picture-uri
    fi
)

vos_restore_background org.cdos.desktop.background
vos_restore_background org.cdos.desktop.background.screensaver
vos_restore_background org.cdos.desktop.background.slideshow
unset -f vos_restore_background
