# Force all packages from the local DebianNFS repository (including mutter 3.36)
Package: *
Pin: release o=DebianNFS
Pin-Priority: 1001

# Keep mutter 3.36.11-m38+1nfs5 pinned even after build repo is removed
Package: mutter mutter-common libmutter-6-0 gir1.2-mutter-6
Pin: version 3.36.11-m38+1nfs5
Pin-Priority: 1001
