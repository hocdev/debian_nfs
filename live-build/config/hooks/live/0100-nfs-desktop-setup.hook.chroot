#!/bin/sh
set -e

echo "=== Removing any stock desktop/DM packages so Found Desktop completely replaces them ==="
STOCK_PKGS=""
for p in \
    gnome-shell gnome-session gnome-session-bin gnome-session-common gnome-panel \
    nautilus xfce4-session xfce4-panel xfdesktop4 mate-session-manager mate-panel \
    cinnamon cinnamon-session lxqt-session lxpanel openbox tint2 gdm3 sddm lxdm
do
    if dpkg-query -W -f='${Status}\n' "$p" 2>/dev/null | grep -q "install ok installed"; then
        STOCK_PKGS="$STOCK_PKGS $p"
    fi
done
if [ -n "$STOCK_PKGS" ]; then
    echo "Purging stock packages:$STOCK_PKGS"
    DEBIAN_FRONTEND=noninteractive apt-get purge -y $STOCK_PKGS
    DEBIAN_FRONTEND=noninteractive apt-get autoremove -y --purge
fi

echo "=== Configuring NFS Found Desktop on Debian 12 ==="
ldconfig

# Patch Python 3.11 collections.abc compatibility in found-tools
for pyf in /usr/share/found-menu-editor/cme/util.py /usr/share/found-launcher-editor/main.py; do
    if [ -f "$pyf" ]; then
        sed -i 's/from collections import Sequence/from collections.abc import Sequence/' "$pyf"
    fi
done

echo "=== Verifying NFS mutter 3.36 is installed (not Debian 12 mutter 43) ==="
for mp in mutter mutter-common libmutter-6-0 gir1.2-mutter-6; do
    VER="$(dpkg-query -W -f='${Version}\n' "$mp" 2>/dev/null || true)"
    echo "  $mp = $VER"
    case "$VER" in
        *nfs*) ;;
        *)
            echo "ERROR: Expected NFS version of $mp, got '$VER'"
            exit 1
            ;;
    esac
done

if [ -d /usr/share/glib-2.0/schemas ]; then
    glib-compile-schemas --strict /usr/share/glib-2.0/schemas
fi

if [ -x /usr/bin/cdos-session ]; then
    update-alternatives --install /usr/bin/x-session-manager x-session-manager /usr/bin/cdos-session 100 || true
    update-alternatives --set x-session-manager /usr/bin/cdos-session || true
fi

if [ -x /usr/bin/cdos-desktop ]; then
    update-alternatives --install /usr/bin/x-window-manager x-window-manager /usr/bin/cdos-desktop 100 || true
    update-alternatives --set x-window-manager /usr/bin/cdos-desktop || true
fi

# Ensure LightDM is the sole DM and defaults to cdos-xorg
echo "/usr/sbin/lightdm" > /etc/X11/default-display-manager
if [ -f /etc/lightdm/lightdm.conf ]; then
    sed -i 's/^#*user-session=.*/user-session=cdos-xorg/' /etc/lightdm/lightdm.conf || true
    sed -i 's/^#*greeter-session=.*/greeter-session=lightdm-gtk-greeter/' /etc/lightdm/lightdm.conf || true
fi

# Ensure Plymouth uses nfslogo theme
if command -v plymouth-set-default-theme >/dev/null 2>&1; then
    plymouth-set-default-theme nfslogo || true
fi

# Keep only cdos-xorg as desktop xsession
for f in /usr/share/xsessions/*.desktop; do
    [ -e "$f" ] || continue
    case "$(basename "$f")" in
        cdos-xorg.desktop|lightdm-xsession.desktop) ;;
        *) rm -f "$f" ;;
    esac
done

# Ensure standard Debian 12 PAM for cdos-screensaver
for pamfile in /etc/pam.d/cdos-screensaver /etc/pam.d/cdos-screensaver-mix /etc/pam.d/cdos-screensaver-qr; do
    cat > "$pamfile" <<'EOF'
auth    required        pam_env.so readenv=1 envfile=/etc/default/locale
@include common-auth
auth    optional        pam_cap.so
auth    optional        pam_gnome_keyring.so
@include common-account
EOF
done

# Set default system locales (English + Vietnamese UTF-8)
if [ -f /etc/locale.gen ]; then
    sed -i 's/^# *en_US.UTF-8 UTF-8/en_US.UTF-8 UTF-8/' /etc/locale.gen
    sed -i 's/^# *vi_VN UTF-8/vi_VN UTF-8/' /etc/locale.gen
    locale-gen || true
fi

# Verify all core NFS Found binaries have zero missing shared libraries
echo "=== Verifying ELF shared library resolution (ldd) ==="
MISSING=0
for bin in \
    /usr/bin/cdos-desktop \
    /usr/lib/cdos-session/cdos-session-binary \
    /usr/lib/found-settings-daemon/cdos-settings-daemon \
    /usr/bin/found-control-center \
    /usr/bin/nemo \
    /usr/bin/nemo-desktop \
    /usr/lib/x86_64-linux-gnu/libmutter-6.so.0 \
    /usr/lib/x86_64-linux-gnu/libfound-desktop-4.so.0 \
    /usr/lib/x86_64-linux-gnu/libfound-gtk3.so.0
do
    if [ -e "$bin" ]; then
        echo "--- ldd $bin ---"
        if ldd "$bin" | grep -E "not found"; then
            echo "ERROR: Missing shared library for $bin"
            MISSING=1
        fi
    else
        echo "ERROR: Expected binary not found: $bin"
        MISSING=1
    fi
done

if [ "$MISSING" -ne 0 ]; then
    exit 1
fi

# Ensure temporary local build repo list is never left in target rootfs
rm -f /etc/apt/sources.list.d/nfs.list* || true

# Rebuild initramfs so Plymouth nfslogo theme is embedded
if command -v update-initramfs >/dev/null 2>&1; then
    update-initramfs -u -k all || true
fi
