#!/bin/sh
set -e

echo "=== Removing any stock desktop/DM packages so Found Desktop completely replaces them ==="
STOCK_PKGS=""
for p in \
    gnome-shell gnome-session gnome-session-bin gnome-session-common gnome-panel \
    nautilus xfce4-session xfce4-panel xfdesktop4 mate-session-manager mate-panel \
    cinnamon cinnamon-session lxqt-session lxpanel openbox tint2 gdm3 sddm lxdm
do
    if dpkg-query -W -f='${Status}\n' "$p" 2>/dev/null | grep -q "install ok installed"; then
        STOCK_PKGS="$STOCK_PKGS $p"
    fi
done
if [ -n "$STOCK_PKGS" ]; then
    echo "Purging stock packages:$STOCK_PKGS"
    DEBIAN_FRONTEND=noninteractive apt-get purge -y $STOCK_PKGS
    DEBIAN_FRONTEND=noninteractive apt-get autoremove -y --purge
fi

echo "=== Configuring VOS ==="
ldconfig
chmod 0755 /usr/bin/nfs-launch-installer

echo "=== Verifying VOS Mutter 3.36 ==="
for mp in mutter mutter-common libmutter-6-0 gir1.2-mutter-6; do
    VER="$(dpkg-query -W -f='${Version}\n' "$mp" 2>/dev/null || true)"
    echo "  $mp = $VER"
    case "$VER" in
        *nfs*) ;;
        *)
            echo "ERROR: Expected VOS version of $mp, got '$VER'"
            exit 1
            ;;
    esac
done

# Remove JingJiaWei-only GPU gschema override in generic ISO build
rm -f /usr/share/glib-2.0/schemas/10_nfs-custom-jjw.gschema.override || true

if [ -d /usr/share/glib-2.0/schemas ]; then
    glib-compile-schemas --strict /usr/share/glib-2.0/schemas
fi

# Ensure X11 default cursor theme uses Found (black cursor) instead of Adwaita
mkdir -p /usr/share/icons/default
cat > /usr/share/icons/default/index.theme <<'EOF'
[Icon Theme]
Inherits=Found
EOF

if [ -x /usr/bin/cdos-session ]; then
    update-alternatives --install /usr/bin/x-session-manager x-session-manager /usr/bin/cdos-session 100 || true
    update-alternatives --set x-session-manager /usr/bin/cdos-session || true
fi

if [ -x /usr/bin/cdos-desktop ]; then
    update-alternatives --install /usr/bin/x-window-manager x-window-manager /usr/bin/cdos-desktop 100 || true
    update-alternatives --set x-window-manager /usr/bin/cdos-desktop || true
fi

# Ensure LightDM is the sole DM and defaults to cdos-xorg
echo "/usr/sbin/lightdm" > /etc/X11/default-display-manager
if [ -f /etc/lightdm/lightdm.conf ]; then
    sed -i 's/^#*user-session=.*/user-session=cdos-xorg/' /etc/lightdm/lightdm.conf || true
    sed -i 's/^#*greeter-session=.*/greeter-session=lightdm-gtk-greeter/' /etc/lightdm/lightdm.conf || true
fi

# Ensure Plymouth uses nfslogo theme
if command -v plymouth-set-default-theme >/dev/null 2>&1; then
    plymouth-set-default-theme nfslogo || true
fi

# Keep only cdos-xorg as desktop xsession
for f in /usr/share/xsessions/*.desktop; do
    [ -e "$f" ] || continue
    case "$(basename "$f")" in
        cdos-xorg.desktop|lightdm-xsession.desktop) ;;
        *) rm -f "$f" ;;
    esac
done

# Set default system locales (English + Vietnamese UTF-8)
if [ -f /etc/locale.gen ]; then
    sed -i 's/^# *en_US.UTF-8 UTF-8/en_US.UTF-8 UTF-8/' /etc/locale.gen
    sed -i 's/^# *vi_VN UTF-8/vi_VN UTF-8/' /etc/locale.gen
    locale-gen || true
fi

# Isolate found-control-center from Debian 12 libgoa (libsoup-3.0) so libsoup-2.4 does not abort
if [ -x /usr/bin/found-control-center ] && [ ! -e /usr/libexec/found-control-center.real ]; then
    mkdir -p /usr/libexec
    mv /usr/bin/found-control-center /usr/libexec/found-control-center.real
    cat > /usr/bin/found-control-center <<'EOF'
#!/bin/bash
export LD_LIBRARY_PATH="/usr/lib/found-control-center-compat${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
exec -a found-control-center /usr/libexec/found-control-center.real "$@"
EOF
    chmod 0755 /usr/bin/found-control-center
fi

# Verify all core VOS Found binaries have zero missing shared libraries
echo "=== Verifying ELF shared library resolution (ldd) ==="
MISSING=0
for bin in \
    /usr/bin/cdos-desktop \
    /usr/lib/cdos-session/cdos-session-binary \
    /usr/lib/found-settings-daemon/cdos-settings-daemon \
    /usr/libexec/found-control-center.real \
    /usr/bin/nemo \
    /usr/bin/nemo-desktop \
    /usr/lib/x86_64-linux-gnu/libmutter-6.so.0 \
    /usr/lib/x86_64-linux-gnu/libfound-desktop-4.so.0 \
    /usr/lib/x86_64-linux-gnu/libfound-gtk3.so.0
do
    if [ -e "$bin" ]; then
        echo "--- ldd $bin ---"
        LDD_PREFIX=""
        if [ "$bin" = "/usr/libexec/found-control-center.real" ]; then
            LDD_PREFIX="LD_LIBRARY_PATH=/usr/lib/found-control-center-compat"
            if eval "$LDD_PREFIX ldd \"$bin\"" | grep -q "libsoup-3"; then
                echo "ERROR: $bin still links libsoup-3"
                MISSING=1
            fi
        fi
        if eval "$LDD_PREFIX ldd \"$bin\"" | grep -E "not found"; then
            echo "ERROR: Missing shared library for $bin"
            MISSING=1
        fi
    else
        echo "ERROR: Expected binary not found: $bin"
        MISSING=1
    fi
done

if [ "$MISSING" -ne 0 ]; then
    exit 1
fi

# Ensure temporary local build repo list is never left in target rootfs
rm -f /etc/apt/sources.list.d/nfs.list* || true

# Remove remaining feedback data if present
rm -f /usr/share/found-desktop/data/feedback \
      /usr/share/found-desktop/data/feedback-service-account.png || true

# Mark desktop installer launcher executable
chmod 0755 /etc/skel/Desktop/nfs-install.desktop /usr/share/applications/nfs-install.desktop

# Configure fcitx5 + fcitx5-lotus as default input method for GTK/Qt/X11 apps
if command -v im-config >/dev/null 2>&1; then
    im-config -n fcitx5 || true
fi
cat > /etc/X11/Xsession.d/95-nfs-fcitx5 <<'EOF'
export GTK_IM_MODULE=fcitx
export QT_IM_MODULE=fcitx
export XMODIFIERS=@im=fcitx
export INPUT_METHOD=fcitx
export SDL_IM_MODULE=fcitx
EOF

# Write the VOS identity to /etc so updates to base-files can replace /usr/lib/os-release.
if [ -L /etc/os-release ]; then
    rm /etc/os-release
fi
cat > /etc/os-release <<'EOF'
PRETTY_NAME="VOS"
NAME="VOS"
NAME_EN="VOS"
VERSION_ID="12"
VERSION="Desktop"
VERSION_CODENAME=bookworm
ID=vos
ID_LIKE=debian
HOME_URL="https://linux.hocdev.com/"
EOF
printf '%s\n' 'VOS \n \l' '' > /etc/issue
printf '%s\n' 'VOS' > /etc/issue.net
cat > /etc/motd <<'EOF'
License terms for installed programs are available in /usr/share/doc/*/copyright.
VOS comes with ABSOLUTELY NO WARRANTY, to the extent permitted by applicable law.
EOF

# Enable fcitx5-lotus-server for live user so Lotus uinput mode works out of the box
if [ -f /usr/lib/systemd/system/fcitx5-lotus-server@.service ]; then
    mkdir -p /etc/systemd/system/multi-user.target.wants
    ln -sf /usr/lib/systemd/system/fcitx5-lotus-server@.service /etc/systemd/system/multi-user.target.wants/fcitx5-lotus-server@user.service
fi

# The Found theme provides only the Lotus status variants. Keep the icons
# installed by the Lotus package in hicolor for Settings and other themes.
if command -v gtk-update-icon-cache >/dev/null 2>&1; then
    gtk-update-icon-cache -f /usr/share/icons/Found || true
fi

# Rebuild initramfs so Plymouth nfslogo theme is embedded
if command -v update-initramfs >/dev/null 2>&1; then
    update-initramfs -u -k all || true
fi
