[org.cdos]
desktop-layout='classic'
enabled-applets=['left:0:menu@cdos.org', 'center:0:scale@cdos.org', 'center:1:window-list@cdos.org', 'right:0:systray@cdos.org', 'right:1:grouped-applets@cdos.org', 'right:2:keyboard@cdos.org', 'right:4:removable-drives@cdos.org', 'right:5:power@cdos.org', 'right:6:sound@cdos.org', 'right:7:network@cdos.org', 'right:8:calendar@cdos.org', 'right:9:notifications@cdos.org', 'right:10:show-desktop@cdos.org']
panel-launchers=['firefox-esr.desktop', 'nemo.desktop', 'org.gnome.Terminal.desktop']
favorite-apps=['firefox-esr.desktop', 'nemo.desktop', 'org.gnome.Terminal.desktop', 'found-control-center.desktop', 'org.gnome.gedit.desktop', 'evince.desktop']

[org.cdos.theme]
name='Found'

[org.cdos.desktop.interface]
gtk-theme='Found'
icon-theme='Found'
cursor-theme='Found'
font-name='Noto Sans 11'
monospace-font-name='Noto Sans Mono 11'

[org.gnome.desktop.interface]
gtk-theme='Found'
icon-theme='Found'
cursor-theme='Found'
font-name='Noto Sans 11'
monospace-font-name='Noto Sans Mono 11'

[org.cdos.desktop.background]
picture-uri='file:///usr/share/backgrounds/found/default.svg'

[org.cdos.desktop.background.screensaver]
picture-uri='/usr/share/backgrounds/found/default.svg'

[org.nemo.desktop]
show-desktop-icons=true

[org.cdos.desktop.default-applications.terminal]
exec='gnome-terminal'
exec-arg=''
